# ============================================================================
# Hi Сайн уу — environment variables
# Copy to .env for local dev; on Railway set these as service variables.
# ============================================================================

# --- api-server (required) ---
# OpenAI key — powers Whisper transcription, GPT-4o-mini translation + image
# scan, and TTS. https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Port the server listens on. Railway injects this automatically in production;
# set it only for local runs.
PORT=8080

# Browser origins allowed to call the API cross-origin, comma-separated. Leave
# empty for the normal single-service deploy (the API serves the client, so all
# calls are same-origin). Only set this if the client is hosted elsewhere —
# every listed origin can spend your OpenAI budget.
# ALLOWED_ORIGINS=https://hisainuu.online,http://localhost:5173

# Per-IP rate limit on the AI routes (/transcribe, /translate, /tts, /scan).
# Defaults: 20 requests per 60000 ms.
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=60000

# --- translator (build-time only) ---
# Base path the PWA is served from. "/" for a root domain (the default).
BASE_PATH=/

# --- database (NOT USED YET) ---
# The api-server does not touch Postgres today. Add this when the first table
# lands in lib/db/src/schema. Use the Neon POOLED connection string.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
